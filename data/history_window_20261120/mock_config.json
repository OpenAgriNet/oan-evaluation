  "rules": [
    {
      "id": "current_crop_advisory",
      "when": {
        "path": "message.intent.category.descriptor.code",
        "equals": "knowledge-advisory"
      },
      "then": {
        "handler": "forward_network",
        "env_file": "${BENCHMARK_NETWORK_ENV_FILE}"
      },
      "_comment": "Real read-only network (user direction 2026-11-22: no mocks where the real service is reachable)."
    },
    {
      "id": "current_aif-agri",
      "when": {
        "path": "message.order.provider.id",
        "equals": "aif-agri"
      },
      "then": {
        "handler": "mock_current_status"
      }
    },
    {
      "id": "current_kcc-agri",
