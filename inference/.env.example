TOKEN=
BASE_URL=

# Optional — Gemma simulates the farmer in run_simulated_scenario.py.
# Point these at the LiteLLM proxy (model name gemma-4-31b-it), not a raw vLLM port.
# LITELLM_API_KEY is the per-person virtual key. Leave it empty for direct vLLM ("dummy").
LITELLM_API_KEY=
SCENARIO_GEMMA_BASE_URL=http://127.0.0.1:4000/v1
SCENARIO_GEMMA_MODEL=openai/gemma-4-31b-it
SCENARIO_INPUT_CSV=
SCENARIO_OUTPUT_CSV=
SCENARIO_OUTPUT_DIR=

# Optional — telemetry
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Optional — only needed by run_audio_vs_text_comparison.py
SARVAM_API_KEY=
